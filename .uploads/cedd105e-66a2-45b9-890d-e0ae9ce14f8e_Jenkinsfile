def sendDingTalkNotification(String status, String message) {
    withCredentials([string(credentialsId: 'DINGTALK_WEBHOOK', variable: 'WEBHOOK_URL')]) {
        def title = status == 'success' ? '✅ 构建CI/CD成功' : '❌ 构建CI/CD失败'

        def body = """{
            "msgtype": "markdown",
            "markdown": {
                "title": "${title}",
                "text": "${message}"
            },
            "at": {
                "isAtAll": false
            }
        }"""

        sh """
            curl -X POST \${WEBHOOK_URL} \\
                -H 'Content-Type: application/json' \\
                -d '${body}'
        """
        echo "DingTalk notification sent: ${status}"
    }
}

def getImage() {
    if (params.ENVIRONMENT == "pro") {
        return "registry.eu-central-1.aliyuncs.com/asl/sysafari-server:${params.MODULE}-${params.VERSION}"
    } else {
        return "registry.cn-shanghai.aliyuncs.com/asl/sysafari-server:${params.MODULE}-${params.VERSION}"
    }
}

def resolveWaitTimeAfterDown() {
    def custom = params.WAIT_TIME_AFTER_DOWN?.trim()
    if (custom) {
        try {
            def val = custom as int
            if (val > 0) {
                echo "使用自定义下线等待时间: ${val}s"
                return val
            }
        } catch (Exception ignored) {
            echo "⚠️ 自定义值 '${custom}' 无效，将使用默认值"
        }
    }

    if (params.ENVIRONMENT == "test" || params.ENVIRONMENT == "dev") {
        return 30
    }

    if (params.MODULE == "declaration-server") {
        return 120
    }

    return 60
}